{
  "name": "orz-slides",
  "version": "0.8.5",
  "description": "Single-file, self-editing HTML slide decks authored in Markdown with layout grammar, themes, and presenter tools.",
  "type": "module",
  "main": "./dist/lib.js",
  "types": "./dist/lib.d.ts",
  "exports": {
    ".": {
      "types": "./dist/lib.d.ts",
      "default": "./dist/lib.js"
    },
    "./package.json": "./package.json"
  },
  "files": [
    "dist",
    "assets/themes",
    "orz-slides-skills",
    "PROTOCOL.md"
  ],
  "scripts": {
    "build": "rm -rf dist && tsc -p tsconfig.build.json && npm run bundle",
    "prebuild": "tsx scripts/sync-version.ts && tsx scripts/build-themes.ts",
    "bundle": "tsx build/bundle.ts",
    "test": "vitest run",
    "pretest": "tsx scripts/sync-version.ts && tsx scripts/build-themes.ts",
    "test:watch": "vitest",
    "typecheck": "tsc --noEmit",
    "clean": "rm -rf dist",
    "prepublishOnly": "npm run build && npm test"
  },
  "keywords": [
    "slides",
    "reveal.js",
    "orz-markdown",
    "markdown",
    "presentation",
    "self-contained",
    "single-file"
  ],
  "author": "Yu Wang <yuwang@orz.how>",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/wangyu16/orz-slides.git"
  },
  "homepage": "https://markdown.orz.how/family.html#slides",
  "bugs": "https://github.com/wangyu16/orz-slides/issues",
  "dependencies": {
    "orz-markdown": "^2.3.0",
    "reveal.js": "5.2.1"
  },
  "devDependencies": {
    "@types/node": "^22.20.5",
    "esbuild": "^0.28.1",
    "playwright-core": "^1.63.0",
    "tsx": "^4.22.4",
    "typescript": "^5.9.3",
    "vitest": "^4.1.10"
  },
  "engines": {
    "node": ">=20.16"
  }
}
