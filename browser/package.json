{
  "name": "orz-slides-browser",
  "version": "1.0.0",
  "description": "The orz-slides browser engine and editor component (FC-19): globalThis.OrzCarrier (IIFE) or ES module exports — mountEditor, assemble, extract, readDocument, renderPreview — with reveal.js 5.2.1 and the 14 slide themes. Served via jsDelivr for .slides.html files; embeddable in web apps.",
  "main": "orz-slides.browser.js",
  "module": "esm/orz-slides.browser.mjs",
  "types": "index.d.ts",
  "exports": {
    ".": {
      "types": "./index.d.ts",
      "import": "./esm/orz-slides.browser.mjs",
      "require": "./require.cjs",
      "default": "./orz-slides.browser.js"
    },
    "./orz-slides.browser.js": "./orz-slides.browser.js",
    "./esm": {
      "types": "./index.d.ts",
      "default": "./esm/orz-slides.browser.mjs"
    },
    "./release.json": "./release.json",
    "./package.json": "./package.json",
    "./docs/embedding.md": "./docs/embedding.md"
  },
  "files": [
    "orz-slides.browser.js",
    "esm/orz-slides.browser.mjs",
    "index.d.ts",
    "release.json",
    "require.cjs",
    "docs/embedding.md",
    "README.md",
    "LICENSE"
  ],
  "scripts": {
    "prepublishOnly": "node scripts/check-release.mjs && cd .. && npx tsx scripts/release-check.ts"
  },
  "keywords": [
    "orz-markdown",
    "orz-slides",
    "markdown",
    "slides",
    "presentation",
    "reveal.js",
    "editor",
    "browser",
    "cdn"
  ],
  "author": "Yu Wang <yuwang@orz.how>",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/wangyu16/orz-slides.git"
  },
  "homepage": "https://markdown.orz.how/slides.html",
  "bugs": "https://github.com/wangyu16/orz-slides/issues",
  "publishConfig": {
    "access": "public"
  }
}
